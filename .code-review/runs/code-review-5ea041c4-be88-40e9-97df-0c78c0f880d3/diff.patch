+from __future__ import annotations
+
+import re
+import sys
+import unittest
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "skills/pretty-common/scripts"))
+
+from quality_contract_gate import (  # noqa: E402
+    RISK_OWNERS,
